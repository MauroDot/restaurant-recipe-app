rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // request.auth.token.restaurantId is set by the syncRestaurantClaim
    // Cloud Function (functions/src/index.ts), which mirrors
    // users/{uid}.restaurantId onto the caller's Auth custom claims. This
    // replaces the earlier uid-segment write-lock workaround: Storage
    // Rules' firestore.get()/exists() cross-service calls don't work in
    // this project (confirmed empirically across several syntax variants),
    // so proper restaurant-membership checks weren't possible until the
    // claim existed to check directly, with no cross-service call needed.
    match /restaurants/{restaurantId}/invoices/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.restaurantId == restaurantId;

      // request.resource represents the proposed new object and is only
      // populated for create/update — it's null on delete, so folding these
      // checks into a blanket `allow write` (as in the original spec) makes
      // every delete evaluate false and get denied, including by the
      // legitimate owner. Split delete out with no resource-shape checks.
      allow create, update: if request.auth != null
        && request.auth.token.restaurantId == restaurantId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null
        && request.auth.token.restaurantId == restaurantId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
