rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A restaurant doc can be created and read only by its owner.
    match /restaurants/{restaurantId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Any member of this restaurant (matched via their own users/{uid}
      // profile, not a client-supplied field) can access its subcollections.
      function isRestaurantMember() {
        return request.auth != null
          && restaurantId ==
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
      }

      // Live stock — mutable (edit/mark spoiled/delete a record).
      match /inventory/{inventoryId} {
        allow read, create, update, delete: if isRestaurantMember();
      }

      // Purchase history and waste log are append-only audit trails.
      match /costHistory/{costHistoryId} {
        allow read, create: if isRestaurantMember();
        allow update, delete: if false;
      }
      match /wasteLog/{wasteId} {
        allow read, create: if isRestaurantMember();
        allow update, delete: if false;
      }

      // Invoices are only ever written as a single "Confirm & Save" from
      // client state that was never persisted before that point (review and
      // editing happen locally) — update is still allowed so a chef can fix
      // a saved invoice later, and delete for removing a bad upload.
      match /invoices/{invoiceId} {
        allow read, write: if isRestaurantMember();
      }

      // Ratings against the shared `ingredients` catalog, but siloed per
      // restaurant (chunk 7: "crowdsourced" means many chefs at one
      // restaurant, not across restaurants). Append-only, like costHistory/
      // wasteLog — a rating shouldn't be editable after the fact.
      match /ingredientRatings/{ratingId} {
        allow read, create: if isRestaurantMember();
        allow update, delete: if false;
      }

      // Written only by aggregateIngredientIntelligence (Cloud Function,
      // Admin SDK — bypasses rules entirely, so this doesn't need a write
      // clause for it). Explicitly false here so no client can forge one.
      match /ingredientIntelligenceCache/{ingredientId} {
        allow read: if isRestaurantMember();
        allow write: if false;
      }
    }

    // A user profile doc can only be created and read by the account it belongs to.
    match /users/{userId} {
      allow create, read: if request.auth != null
        && request.auth.uid == userId;
    }

    // Shared ingredient catalog, seeded once from the client. Readable by
    // any authenticated user; creates are shape-checked since this is a
    // global collection every restaurant reads, not owner-scoped.
    match /ingredients/{ingredientId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'unit', 'currentCost', 'trimLoss'])
        && request.resource.data.currentCost is number
        && request.resource.data.trimLoss is number;
      allow update, delete: if false;
    }

    // Singleton doc guarding the one-time ingredient seed against a
    // double-insert race (see src/lib/seedIngredients.ts).
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && docId == 'ingredientsSeed';
      allow update: if request.auth != null
        && docId == 'ingredientsSeed'
        && request.resource.data.seeded == true;
      allow delete: if false;
    }

    // A recipe is scoped to the restaurant of the user who created it —
    // derived from the caller's own users/{uid} doc, never trusted as a
    // bare client-supplied field.
    match /recipes/{recipeId} {
      allow create: if request.auth != null
        && request.resource.data.restaurantId ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.restaurantId ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
      // Still immutable for clients — aggregateRating/ratingCount/lastRatedAt/
      // status are only ever written by Cloud Functions (Admin SDK, bypasses
      // rules entirely), never by a chef directly. If a client could update
      // its own recipe doc, it could fake its own rating.
      allow update, delete: if false;

      // Append-only, like costHistory/wasteLog — feedback isn't editable
      // after submission. Membership is derived from the PARENT recipe's
      // restaurantId (one extra get()), not a client-supplied field.
      match /feedback/{feedbackId} {
        allow read, create: if request.auth != null
          && get(/databases/$(database)/documents/recipes/$(recipeId)).data.restaurantId ==
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
